# Flask
SECRET_KEY=change-this-to-a-random-secret

# Supabase Postgres (Session pooler yoki Direct connection)
# Supabase Dashboard -> Project Settings -> Database -> Connection string
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Supabase Storage (audio va avatar fayllar uchun, agar Google avatar kifoya bo'lmasa)
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_BUCKET=audio-posts

# Google OAuth (Google Cloud Console -> Credentials -> OAuth 2.0 Client ID)
# Authorized redirect URI: http://localhost:5000/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
